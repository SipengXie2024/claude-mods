{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "typeRoots": ["../.claude-plugin/types", "./node_modules/@types", "../node_modules/@types"],
    "types": ["bun", "claude-code", "claude-code-tools", "claude-code-mcp"]
  },
  "include": ["./", "../eval", "../src"]
}
