#!/usr/bin/env bash
# The only Claude session allowed to talk to Telegram, run as a Router under
# claude-magpie: each request goes to a background worker (mods/tg-router), a
# reply to any message of a request reaches that request's worker, and the
# magpie-tasks plugin routes each worker's model and hands long tasks to their
# architect sessions.
# Telegram allows one poller per bot token, and every new channel server kills
# the previous one. The token lives only in telegram-live/, so ordinary
# sessions (which use the default channels/telegram/ dir) exit at startup
# without polling; this launcher points the channel at telegram-live/.
#
# - claude-magpie passes its gateway settings with --settings, and of several
#   --settings only the last applies, so this launcher passes none. The
#   official telegram plugin therefore stays enabled here; it reads the default
#   channels/telegram/, which holds no token, and exits at startup.
# - TELEGRAM_STATE_DIR reaches the channel server alone, through the MCP
#   config's env; tg-router reads the same folder as TG_ROUTER_STATE_DIR.
# - MAGPIE_TASKS_ROLE=router makes magpie-tasks treat this session as the
#   Router rather than a long-task window.
# - The Router runs on Opus 5.5 (Magpie's default model is Astra) at low effort:
#   it only routes and talks, long input and short output, as DeepSeek's
#   Super-agent article found for its Router layer. JEV_MAIN_EFFORT makes JEV
#   keep the main loop at that level (no Jev ask, no raise); a /effort typed in
#   the pane still wins. Workers get their own model and effort from magpie-tasks.
cd "$HOME" || exit 1
CLAUDE_MODS="${CLAUDE_MODS:-$HOME/claude-mods}"
CHANNEL_DIR="$CLAUDE_MODS/examples/claude-telegram/tg-channel"
LIVE="$HOME/.claude/channels/telegram-live"
export MAGPIE_TASKS_ROLE=router
export TG_ROUTER_STATE_DIR="$LIVE"
export JEV_MAIN_EFFORT=low
# Claude Code asks for a one-line progress summary of each background worker about every 30 s, each
# request carrying the worker's whole context; under claude-magpie each one starts a `claude -p` helper
# (about 270 MB) that lingers for about 200 s, some 1.5-1.8 GB per running worker (measured
# 2026-11-11). Nothing here reads those summaries: tg-router posts its own progress cards.
export CLAUDE_CODE_DISABLE_AGENT_PROGRESS_SUMMARIES=1

# tg-router runs from a copy made at each start. Claude Code reloads a --plugin-dir whenever a file in
# it changes, and a reload drops the mod's state in memory (messages waiting to be dispatched, progress
# cards); tasks integrate changes into this repository while the Router runs. The copy keeps those
# changes for the next start.
ROUTER_COPY="$HOME/.local/share/claude-telegram/tg-router"
rm -rf "$ROUTER_COPY" && mkdir -p "${ROUTER_COPY%/*}" && cp -a "$CLAUDE_MODS/mods/tg-router" "$ROUTER_COPY" || exit 1

# The channel is tg-channel, a copy of the official telegram plugin's server
# that also reports which message a message replies to. It is not on the
# approved channel list, so it loads as a development channel: Claude Code asks
# for one confirmation at each start.
mcp_config=$(jq -nc --arg dir "$CHANNEL_DIR" --arg live "$LIVE" \
  '{mcpServers: {"tg-channel": {command: "bun", args: ["run", "--cwd", $dir, "--shell=bun", "--silent", "start"], env: {TELEGRAM_STATE_DIR: $live}}}}')

# claude-magpie refreshes every subscription's model list as it starts. For the
# Antigravity account that prints three lines on stderr: the sign-in's tiers, Google
# answering the paid-tier entitlement with HTTP 400 "invalid argument", and the list
# fetched again without it. magpie handles that retry itself, but the lines land
# inside Claude Code's start-up dialog and cover its options. Exactly those three
# shapes are dropped; every other stderr line, an Antigravity failure included, still
# reaches the terminal.
HIDE='^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9:]{8} antigravity [^ ]+: (loadCodeAssist at [^ ]+: current tier |fetchAvailableModels with entitlement [^ ]+: Antigravity: Request contains an invalid argument\.; asking with none next$|fetchAvailableModels at .*\): [1-9][0-9]* models, [1-9][0-9]* kept; )'

exec claude-magpie --model 'claude/claude-opus-5-5[1m]' --effort low --dangerously-skip-permissions \
  --mcp-config "$mcp_config" \
  --dangerously-load-development-channels server:tg-channel \
  --plugin-dir "$ROUTER_COPY" \
  "$@" \
  2> >(grep --line-buffered -v -E "$HIDE" >&2)
